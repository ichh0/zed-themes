{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Icho Amber Glass",
  "author": "Liquide",
  "themes": [
    {
      "name": "Icho Amber Glass",
      "appearance": "dark",
      "style": {
        "background.appearance": "blurred",

        "background": "#120F0DD9",
        "surface.background": "#120F0DD9",
        "elevated_surface.background": "#1A1512",

        "border": "#00000000",
        "border.variant": "#00000000",
        "border.focused": "#E8B07A55",
        "border.selected": "#E8B07A55",
        "border.transparent": "#00000000",
        "border.disabled": "#00000000",

        "element.background": "#1D1713",
        "element.hover": "#282019",
        "element.active": "#2D241C",
        "element.selected": "#30251D",
        "element.disabled": "#15110F",
        "drop_target.background": "#E8B07A25",

        "ghost_element.background": "#00000000",
        "ghost_element.hover": "#241C17",
        "ghost_element.active": "#2D241C",
        "ghost_element.selected": "#30251D",
        "ghost_element.disabled": "#00000000",

        "text": "#E5DDD5",
        "text.muted": "#A49A91",
        "text.placeholder": "#766E67",
        "text.disabled": "#625B55",
        "text.accent": "#E8B07A",

        "icon": "#A49A91",
        "icon.muted": "#887F77",
        "icon.disabled": "#625B55",
        "icon.placeholder": "#766E67",
        "icon.accent": "#E8B07A",

        "status_bar.background": "#120F0DD9",
        "title_bar.background": "#120F0DD9",
        "title_bar.inactive_background": "#0F0C0BD0",

        "toolbar.background": "#00000000",
        "tab_bar.background": "#00000000",
        "tab.inactive_background": "#00000000",
        "tab.active_background": "#1D1713",

        "search.match_background": "#E8B07A25",
        "search.active_match_background": "#E8B07A50",

        "panel.background": "#00000000",
        "panel.focused_border": "#00000000",
        "panel.indent_guide": "#2A211B",
        "panel.indent_guide_active": "#4C4035",
        "panel.indent_guide_hover": "#A9815E",
        "panel.overlay_background": "#1A1512",

        "pane.focused_border": "#00000000",
        "pane_group.border": "#00000000",

        "scrollbar.thumb.background": "#66594D70",
        "scrollbar.thumb.hover_background": "#7B6B5C",
        "scrollbar.thumb.active_background": "#897765",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "#00000000",

        "editor.foreground": "#E5DDD5",
        "editor.background": "#00000000",
        "editor.gutter.background": "#00000000",
        "editor.subheader.background": "#1A1512",
        "editor.active_line.background": "#E8B07A08",
        "editor.highlighted_line.background": "#E8B07A10",
        "editor.line_number": "#554C45",
        "editor.active_line_number": "#C9BEB4",
        "editor.invisible": "#514941",
        "editor.wrap_guide": "#2A211B",
        "editor.active_wrap_guide": "#4C4035",
        "editor.indent_guide": "#2A211B",
        "editor.indent_guide_active": "#4C4035",
        "editor.document_highlight.read_background": "#E8B07A12",
        "editor.document_highlight.write_background": "#E8B07A1A",

        "terminal.background": "#00000000",
        "terminal.foreground": "#A49A91",
        "terminal.bright_foreground": "#E5DDD5",
        "terminal.dim_foreground": "#766E67",

        "terminal.ansi.background": "#120F0D",
        "terminal.ansi.black": "#120F0D",
        "terminal.ansi.red": "#D98778",
        "terminal.ansi.green": "#9DC1A8",
        "terminal.ansi.yellow": "#E8B07A",
        "terminal.ansi.blue": "#9DAFC5",
        "terminal.ansi.magenta": "#C19AB4",
        "terminal.ansi.cyan": "#91BDBA",
        "terminal.ansi.white": "#E5DDD5",

        "terminal.ansi.bright_black": "#766E67",
        "terminal.ansi.bright_red": "#E49A89",
        "terminal.ansi.bright_green": "#AED1B8",
        "terminal.ansi.bright_yellow": "#F0C18F",
        "terminal.ansi.bright_blue": "#B0C0D5",
        "terminal.ansi.bright_magenta": "#D0ABC4",
        "terminal.ansi.bright_cyan": "#A4D2CF",
        "terminal.ansi.bright_white": "#F2ECE6",

        "link_text.hover": "#F0C18F",

        "conflict": "#D5A96F",
        "conflict.background": "#D5A96F15",
        "conflict.border": "#D5A96F",

        "created": "#9DC1A8",
        "created.background": "#9DC1A815",
        "created.border": "#9DC1A8",

        "deleted": "#D98778",
        "deleted.background": "#D9877815",
        "deleted.border": "#D98778",

        "error": "#D98778",
        "error.background": "#291817",
        "error.border": "#D98778",

        "hidden": "#766E67",
        "hidden.background": "#120F0D",
        "hidden.border": "#120F0D",

        "hint": "#9DAFC5",
        "hint.background": "#1D1713",
        "hint.border": "#2A211B",

        "ignored": "#766E67",
        "ignored.background": "#120F0D",
        "ignored.border": "#120F0D",

        "info": "#9DAFC5",
        "info.background": "#1D1713",
        "info.border": "#2A211B",

        "modified": "#E8B07A",
        "modified.background": "#E8B07A15",
        "modified.border": "#E8B07A",

        "predictive": "#766E67",
        "predictive.background": "#120F0D",
        "predictive.border": "#120F0D",

        "renamed": "#E8B07A",
        "renamed.background": "#E8B07A15",
        "renamed.border": "#E8B07A",

        "success": "#9DC1A8",
        "success.background": "#9DC1A815",
        "success.border": "#9DC1A8",

        "unreachable": "#D98778",
        "unreachable.background": "#D9877815",
        "unreachable.border": "#D98778",

        "warning": "#D5A96F",
        "warning.background": "#292018",
        "warning.border": "#D5A96F",

        "players": [
          {
            "cursor": "#E8B07A",
            "selection": "#E8B07A25",
            "background": "#E8B07A"
          },
          {
            "cursor": "#9DC1A8",
            "selection": "#9DC1A825",
            "background": "#9DC1A8"
          },
          {
            "cursor": "#D98778",
            "selection": "#D9877825",
            "background": "#D98778"
          },
          {
            "cursor": "#9DAFC5",
            "selection": "#9DAFC525",
            "background": "#9DAFC5"
          }
        ],

        "syntax": {
          "attribute": {
            "color": "#A49A91"
          },
          "boolean": {
            "color": "#E8B07A"
          },
          "comment": {
            "color": "#766E6794"
          },
          "comment.doc": {
            "color": "#80766EA8"
          },
          "constant": {
            "color": "#D9A878"
          },
          "constructor": {
            "color": "#E8B07A"
          },
          "emphasis": {
            "color": "#E5DDD5",
            "font_style": "italic"
          },
          "emphasis.strong": {
            "color": "#EEE7E0",
            "font_weight": 700
          },
          "function": {
            "color": "#E8B07A"
          },
          "keyword": {
            "color": "#B99A7A"
          },
          "label": {
            "color": "#D2A77E"
          },
          "link_text": {
            "color": "#D8CFC7"
          },
          "link_uri": {
            "color": "#E8B07A"
          },
          "number": {
            "color": "#D9A878"
          },
          "operator": {
            "color": "#81776F"
          },
          "punctuation": {
            "color": "#756C64"
          },
          "punctuation.bracket": {
            "color": "#978474"
          },
          "punctuation.delimiter": {
            "color": "#756C64"
          },
          "punctuation.list_marker": {
            "color": "#978474"
          },
          "punctuation.special": {
            "color": "#C19A78"
          },
          "string": {
            "color": "#9DC1A8"
          },
          "string.escape": {
            "color": "#E8B07A"
          },
          "string.regex": {
            "color": "#C19A78"
          },
          "string.special": {
            "color": "#9DC1A8"
          },
          "string.special.symbol": {
            "color": "#E8B07A"
          },
          "tag": {
            "color": "#E8B07A"
          },
          "text.literal": {
            "color": "#9DC1A8"
          },
          "title": {
            "color": "#D9A878"
          },
          "type": {
            "color": "#D2A77E"
          },
          "variable": {
            "color": "#E5DDD5"
          },
          "variable.special": {
            "color": "#A49A91"
          }
        }
      }
    }
  ]
}
